# Copy to .env and fill in. .env is gitignored: never commit keys.

# Provider: openai (any OpenAI-compatible endpoint; the hackathon's Alibaba Cloud Model Studio) | anthropic
PRECEDENT_PROVIDER=openai
OPENAI_COMPAT_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
OPENAI_COMPAT_API_KEY=
# ANTHROPIC_API_KEY=            # only for PRECEDENT_PROVIDER=anthropic

# Model roles (PRD §5). Defaults for provider=openai shown; THINKING sends enable_thinking.
# PRECEDENT_FAST_MODEL=qwen3.8-flash
# PRECEDENT_FAST_THINKING=0
# PRECEDENT_CORE_MODEL=qwen3.8-max
# PRECEDENT_REASON_MODEL=deepseek-v4-pro
# PRECEDENT_PRICE_QWEN3_8_MAX=in,out   # USD per 1M tokens, if you want a cost figure for the stats panel

# PRECEDENT_CONCURRENCY=8
# PRECEDENT_OFFLINE=0            # 1 = cache only (demo mode), never call the API
# PRECEDENT_DB=data/precedent.db

# Embeddings: auto | st | voyage | hash   (Model Studio plan has no embeddings endpoint; auto -> local st)
# PRECEDENT_EMBED=auto
