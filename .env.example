# Copy to .env and fill in. Everything except the key has a sensible default.
ANTHROPIC_API_KEY=

# Model roles (PRD §5)
# PRECEDENT_FAST_MODEL=claude-haiku-4-5-20251001
# PRECEDENT_CORE_MODEL=claude-sonnet-5-5
# PRECEDENT_CORE_EFFORT=medium
# PRECEDENT_REASON_MODEL=claude-opus-5-5
# PRECEDENT_REASON_EFFORT=high

# PRECEDENT_CONCURRENCY=8
# PRECEDENT_FALLBACKS=1          # server-side refusal fallback on the 5.x models
# PRECEDENT_OFFLINE=0            # 1 = cache only (demo mode), never call the API
# PRECEDENT_DB=data/precedent.db

# Embeddings: auto | voyage | st | hash
# PRECEDENT_EMBED=auto
# VOYAGE_API_KEY=
